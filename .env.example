# SRS Chat Agent — copy this file to .env in your project root and fill in your values.
# Your .env file is git-ignored and personal — each team member has their own.
# Obtain your API key from the SRS AI admin portal.

SRS_CHAT_API_KEY=arcai-YOUR_KEY_HERE
SRS_CHAT_BASE_URL=https://chat.srs-ai.build

# Optional: if provided, sent with each query for attribution in chat logs.
# SRS_CHAT_USER_EMAIL=you@example.com
# SRS_CHAT_USER_NAME=YourName

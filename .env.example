# ────────────────────────────────────────────────────────────────────────────────
# THIS IS A REFERENCE TEMPLATE — do NOT overwrite or delete your existing .env
#
# If you already have a .env in the project root, keep it.  This file exists
# only so new team members know which variables to set.  Copy it once:
#
#   cp .env.example .env          # macOS / Linux
#   copy .env.example .env        # Windows cmd
#
# Then edit the NEW .env file with your own values.
#
# Your .env is git-ignored and personal — every team member has their own copy.
# Losing it means losing your API key until you regenerate one from the portal.
# ────────────────────────────────────────────────────────────────────────────────

SRS_CHAT_API_KEY=arcai-YOUR_KEY_HERE
SRS_CHAT_BASE_URL=https://chat.srs-ai.build

# Optional: if provided, sent with each query for attribution in chat logs.
# SRS_CHAT_USER_EMAIL=you@example.com
# SRS_CHAT_USER_NAME=YourName
